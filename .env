# =============================================================================
# Environment Variables Template (.env.example)
# Project: Akıllı Servis Masası ve Sistem Uzmanı Chatbot (PRJIC20260201)
# Description:
#     Standard template documenting all required environment variables
#     for local development, automated testing, and multi-container Docker deployment.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. PostgreSQL & pgvector Database Configuration
# -----------------------------------------------------------------------------
# Database credentials and connection parameters
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password123
POSTGRES_DB=it_support_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5434

# Cryptographic secret for signing JWT
JWT_SECRET_KEY=ai_servicedesk_super_secret_jwt_key_2026_production_safe_token

# SQLAlchemy Async Connection URL (for containerized bridge network)
DATABASE_URL=postgresql+asyncpg://postgres:password123@db:5432/it_support_db

# -----------------------------------------------------------------------------
# 2. OpenAI API & Foundation Model Configuration
# -----------------------------------------------------------------------------
# OpenAI API credentials (GPT-4o-mini & Embedding models)
OPENAI_API_KEY=sk-your-openai-api-key-here
LLM_MODEL_NAME=gpt-4o-mini
OPENAI_MODEL=gpt-4o-mini

# Embedding Model Identifier (HuggingFace local / OpenAI API)
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Generation Hyperparameters (Deterministic for technical accuracy)
LLM_TEMPERATURE=0.2
OPENAI_TEMPERATURE=0.2
LLM_MAX_TOKENS=1000
OPENAI_MAX_TOKENS=1000

# -----------------------------------------------------------------------------
# 3. Security, Authentication & JWT Configuration
# -----------------------------------------------------------------------------
# Cryptographic secret for signing JWT access & refresh tokens
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=your_super_secret_jwt_key_generate_with_openssl_rand_hex_32
ALGORITHM=HS256
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# -----------------------------------------------------------------------------
# 4. RAG Retrieval Engine & Anti-Hallucination Guardrails
# -----------------------------------------------------------------------------
# Minimum normalized score required to bypass safe fallback (0.0 to 1.0)
CONFIDENCE_THRESHOLD=0.25
RAG_CONFIDENCE_THRESHOLD=0.25
RAG_CONFIDENCE_THRESHOLD_RAW=0.020

# Reciprocal Rank Fusion (RRF) smoothing constant (Standard: 60)
RRF_K_PARAMETER=60

# Maximum number of top-ranked chunks injected into LLM context
MAX_RETRIEVAL_DOCS=3

# -----------------------------------------------------------------------------
# 5. Service Endpoints & Runtime Environment
# -----------------------------------------------------------------------------
# Internal API URL for Streamlit UI -> FastAPI communication
API_URL=http://api:8000
BACKEND_URL=http://api:8000
# Note for local non-Docker UI: use API_URL=http://127.0.0.1:8000

# Application Environment Mode (development | production)
APP_ENV=production
