# =============================================================================
# Dockerfile for Streamlit Web UI Frontend Service
# Project: Akıllı Servis Masası ve Sistem Uzmanı Chatbot (PRJIC20260201)
# =============================================================================

# 1. Base Image
FROM python:3.11-slim

# 2. Environment Variables
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app \
    PIP_DEFAULT_TIMEOUT=1000 \
    PIP_RETRIES=5

# 3. Working Directory
WORKDIR /app

# 4. System Dependencies (Healthcheck & Networking)
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/*

# 5. Pre-install Lightweight CPU PyTorch (Fast build / Layer Cache match)
RUN pip install --no-cache-dir torch --index-url https://download.pytorch.org/whl/cpu

# 6. Dependency Layer Caching
COPY requirements.txt /app/
RUN pip install --no-cache-dir -r requirements.txt

# 7. Copy Application Source Code
COPY . /app/

# 8. Expose Streamlit Port
EXPOSE 8501

# 9. Start Streamlit Application (Headless & Network Bound)
CMD ["streamlit", "run", "src/ui/app.py", "--server.port=8501", "--server.address=0.0.0.0", "--server.headless=true"]
